# Production env for the marketing site. On EC2 the real file is ~/growblic-site/.env, read by
# docker-compose.selfhost.yml (compose loads .env from the directory it is run in).
#
#   cd ~/growblic-site && cp .env.example .env && nano .env
#   docker compose -p growblic-site -f docker-compose.selfhost.yml up -d growblic-site   # NOT restart
#
# NEVER commit the real .env — only this example belongs in git (.gitignore allows exactly this file).

# Resend API key, from https://resend.com → API Keys. Starts with `re_`.
# EMPTY OR UNSET IS SUPPORTED, and is what prod ran until now: every contact-form and careers
# submission is still written to the leads volume (growblic-site_leads → /app/data); only the email
# copy is skipped. Setting this turns the emails on; it changes nothing about what is stored.
RESEND_API_KEY=

# Where enquiry emails are delivered.
CONTACT_TO=hello@growblic.com

# The From address. Its domain MUST be verified in Resend (Domains → Add → DNS records), or Resend
# rejects the send and the email silently never arrives — the lead is still saved, so nothing looks
# broken. `onboarding@resend.dev` is Resend's shared sandbox sender: it works with no domain
# verification but only delivers to the address that owns the Resend account. For real delivery to
# CONTACT_TO, verify growblic.com in Resend and use e.g. `Growblic Website <hello@growblic.com>`.
CONTACT_FROM=Growblic Website <onboarding@resend.dev>
